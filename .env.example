# ============================================================
# nucleo-juridico-backend — variáveis de ambiente (exemplo)
# ------------------------------------------------------------
# Copie para .env e preencha com valores reais. NÃO COMMITE o .env.
# Veja DEPLOY.md para onde encontrar cada valor.
# ============================================================

# --- Aplicação ---
APP_NAME=nucleo-juridico-backend
APP_ENV=development            # development | staging | production
APP_DEBUG=true                 # false em produção
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Banco de dados (Supabase PostgreSQL) ---
# Use o "Transaction Pooler" (porta 6543) do Supabase em produção.
# O prefixo `postgresql://` é automaticamente convertido para
# `postgresql+psycopg://` pelo backend, mas você pode já fornecer assim.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_ID:SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Supabase ---
# Supabase Studio → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.<anon-public>
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.<service-role-secret>
# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=seu-jwt-secret

# --- Storage ---
SUPABASE_STORAGE_BUCKET=documentos

# --- Frontend ---
# URL pública do frontend (sem barra no final), usada nos links de e-mail
# (convite de novo usuário, reset de senha). Em prod: a URL da Vercel.
FRONTEND_URL=https://nucleo-juridico-frontend-fon2.vercel.app

# --- CORS ---
# Lista de origens permitidas, separadas por vírgula.
# Em produção: a URL final da Vercel, sem barra no final.
CORS_ORIGINS=http://localhost:3000

# (Opcional) Regex para liberar previews do Vercel automaticamente.
# Ex.: ^https://nucleo-juridico-frontend(-[\w-]+)?\.vercel\.app$
# CORS_ORIGIN_REGEX=

# --- JWT ---
# Para projetos novos do Supabase os tokens podem vir como ES256/RS256;
# o backend detecta o algoritmo no header e busca a chave pública via JWKS.
JWT_ALGORITHM=HS256
JWT_AUDIENCE=authenticated
