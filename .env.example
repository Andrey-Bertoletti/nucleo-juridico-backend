# ============================================================
# nucleo-juridico-backend — variáveis de ambiente (exemplo)
# ------------------------------------------------------------
# Copie para .env e preencha com valores reais. NÃO COMMITE o .env.
# Veja DEPLOY.md para onde encontrar cada valor.
# ============================================================

# --- Aplicação ---
APP_NAME=nucleo-juridico-backend
APP_ENV=development            # development | staging | production
APP_DEBUG=true                 # false em produção
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Banco de dados (Supabase PostgreSQL) ---
# Use o "Transaction Pooler" (porta 6543) do Supabase em produção.
# O prefixo `postgresql://` é automaticamente convertido para
# `postgresql+psycopg://` pelo backend, mas você pode já fornecer assim.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_ID:SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Supabase ---
# Supabase Studio → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.<anon-public>
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.<service-role-secret>
# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=seu-jwt-secret

# --- Storage ---
SUPABASE_STORAGE_BUCKET=documentos

# --- Frontend ---
# URL pública do frontend (sem barra no final), usada nos links de e-mail
# (convite de novo usuário, reset de senha). Em prod: a URL da Vercel.
FRONTEND_URL=https://nucleo-juridico-frontend-fon2.vercel.app
# Redirects EXATOS aceitos pelo backend para e-mails do Supabase Auth.
# Deve espelhar Authentication -> URL Configuration -> Redirect URLs.
AUTH_ALLOWED_REDIRECT_URLS=https://nucleo-juridico-frontend-fon2.vercel.app/reset-password,http://localhost:3000/reset-password,http://127.0.0.1:3000/reset-password

# --- CORS ---
# Lista de origens permitidas, separadas por vírgula.
# Em produção: a URL final da Vercel, sem barra no final.
CORS_ORIGINS=http://localhost:3000

# (Opcional) Regex para liberar previews do Vercel automaticamente.
# Ex.: ^https://nucleo-juridico-frontend(-[\w-]+)?\.vercel\.app$
# CORS_ORIGIN_REGEX=

# --- JWT ---
# Para projetos novos do Supabase os tokens podem vir como ES256/RS256;
# o backend detecta o algoritmo no header e busca a chave pública via JWKS.
JWT_ALGORITHM=HS256
JWT_AUDIENCE=authenticated

# --- IA (Análise com IA — Fase 1) ---
# Provedor de IA. Preencha AI_API_KEY com a chave do provedor escolhido:
#   - anthropic (Claude): AI_API_KEY = chave da Anthropic.
#                         AI_MODEL opcional (default: claude-opus-4-8; ou claude-sonnet-4-6).
#   - openai:             AI_API_KEY = chave da OpenAI.
#                         AI_MODEL recomendado definir (ex.: gpt-4o).
AI_ENABLED=true
AI_PROVIDER=anthropic          # anthropic | openai | local
AI_API_KEY=                    # chave do provedor escolhido
AI_MODEL=claude-sonnet-4-6     # ex.: claude-opus-4-8 | claude-sonnet-4-6 | gpt-4o
AI_MAX_INPUT_CHARS=120000

# --- Supabase Auth SMTP (usado pelo supabase/config.toml e Dashboard) ---
# Configure equivalentes no Dashboard do Supabase em produção.
SUPABASE_AUTH_EMAIL_SMTP_HOST=smtp.sendgrid.net
SUPABASE_AUTH_EMAIL_SMTP_USER=apikey
SUPABASE_AUTH_EMAIL_SMTP_PASS=sua-chave-smtp
SUPABASE_AUTH_EMAIL_SMTP_ADMIN_EMAIL=no-reply@seudominio.com.br
